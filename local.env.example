# =============================================================================
# Shared local secrets (optional) — copy to local.env at repo root
# Overrides ops/discord-bot/.env and supplements web/.env.local for the bot.
# =============================================================================

# Discord bot (required for npm start in ops/discord-bot)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_OWNER_IDS=your_discord_user_id

# Shared webhook auth — MUST match web/.env.local PLATFORM_API_SECRET
PLATFORM_API_SECRET=

# Team Space signed cookies (web only; can match PLATFORM_API_SECRET locally)
TEAM_SESSION_SECRET=
