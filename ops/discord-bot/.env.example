# Bot-specific settings (copy to .env)
# Shared secrets (DISCORD_BOT_TOKEN, PLATFORM_API_SECRET) can live in web/.env.local instead.

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1432509930220425239
DISCORD_OWNER_IDS=123456789012345678
DISCORD_STAFF_LOG_CHANNEL_ID=
# Public #launches channel — boost alerts (Pulse / Spotlight / Signal). Optional if channel is named "launches".
DISCORD_LAUNCHES_CHANNEL_ID=
# Optional — moderation embeds (falls back to staff log if unset)
DISCORD_MOD_LOG_CHANNEL_ID=
MOD_FILTER_ENABLED=true
MOD_TIMEOUT_MINUTES=10
SITE_URL=https://www.eyesopen.to
SNAPSHOT_PATH=../../data/platform-snapshot.json
WEB_SNAPSHOT_PATH=../../web/data/platform-snapshot.json
DB_PATH=./data/platform.db

# Reward amounts (tokens, locked by default)
REFERRAL_REWARD_DISCORD=500
REFERRAL_REWARD_TELEGRAM=500
REFERRAL_REWARD_CLICK=10
REFERRAL_REWARD_JOIN=2500
REFERRAL_REWARD_CONTRIBUTION=5000
TEAM_POOL_TOKENS=100000000
LARGE_UNLOCK_THRESHOLD=100000

# Must match web/.env.local (same value on both sides)
PLATFORM_API_SECRET=
WEBHOOK_PORT=3847

# Launchpad Command X commands (!xlist !xstatus !xcheck !xpost !xboost).
# Local Warden reads %APPDATA%\LaunchpadCommand\warden.key after the LPC host starts.
# Railway Warden needs a reachable LPC_HOST plus LPC_BOT_KEY (same value as warden.key).
# LPC_HOST=http://127.0.0.1:7741
# LPC_BOT_KEY=

# Local dev: leave unset so only Railway connects to Discord (prevents double command replies).
# Set RUN_LOCAL_DISCORD_BOT=true only when Railway is stopped and you need !commands locally.
# RUN_LOCAL_DISCORD_BOT=true

# Presale token distribution (Phase 2 — treasury sends $EYES to receive addresses)
PRESALE_TOKEN_CAP=200000000
# EYES_TOKEN_ADDRESS=0x...
# PRESALE_DISTRIBUTOR_PRIVATE_KEY=   # treasury wallet that holds presale $EYES
# BASE_MAINNET_RPC_URL=https://mainnet.base.org
# PRESALE_CHAIN_ID=8453              # 31337 for Anvil local
# PRESALE_DISTRIBUTE_BATCH=5
# PRESALE_DISTRIBUTE_DRY_RUN=true
