# =============================================================================
# Eyes Open — LOCAL Anvil only (never deploy this to eyesopen.to)
# Copy to web/.env.local for local coin testing.
# The Discord bot also reads this file for shared secrets (token + API secret).
# =============================================================================

NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_USE_ANVIL=true
NEXT_PUBLIC_ANVIL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_CHAIN_NAME=Anvil Local

# Launch countdown (optional for local UI testing)
NEXT_PUBLIC_LAUNCH_END_ISO=2026-09-12T01:00:00.000Z

# Synced by: .\scripts\sync-deploy-to-web.ps1 -Network anvil
NEXT_PUBLIC_LAUNCH_FACTORY_ADDRESS=
NEXT_PUBLIC_EYES_TOKEN_ADDRESS=
NEXT_PUBLIC_FEE_COLLECTOR_ADDRESS=

NEXT_PUBLIC_SOCIAL_X=https://x.com/eyesopenlaunch
NEXT_PUBLIC_SOCIAL_TELEGRAM=https://t.me/+WGZTDwqoswNlODMx

NEXT_PUBLIC_FEATURE_WALLET=true
NEXT_PUBLIC_FEATURE_CREATE_LAUNCH=true

PLATFORM_SNAPSHOT_PATH=./data/platform-snapshot.json
BOT_WEBHOOK_URL=http://localhost:3847

# --- Discord bot (bot reads these from this file locally) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_OWNER_IDS=
PLATFORM_API_SECRET=
TEAM_SESSION_SECRET=
