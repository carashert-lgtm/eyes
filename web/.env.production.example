# =============================================================================
# Eyes Open — LOCKED PRODUCTION (eyesopen.to / Vercel project: eyes)
# Copy each line into Vercel → Settings → Environment Variables → Production
# Do NOT copy web/.env.local (Anvil). Do NOT set NEXT_PUBLIC_USE_ANVIL=true.
# =============================================================================

# --- Environment (required) ---
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://www.eyesopen.to
NEXT_PUBLIC_USE_ANVIL=false

# --- Launch countdown (homepage timer — display only) ---
NEXT_PUBLIC_LAUNCH_END_ISO=2026-09-12T01:00:00.000Z

# --- Chain (Base mainnet) ---
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_CHAIN_NAME=Base
# Do NOT set NEXT_PUBLIC_ANVIL_RPC_URL in production

# --- Legal (public-facing policy pages) ---
NEXT_PUBLIC_LEGAL_ENTITY_NAME=Eyes Open
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=legal@eyesopen.to
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@eyesopen.to
# Optional: NEXT_PUBLIC_LEGAL_GOVERNING_LAW=the State of Delaware, United States

# Launch stack (mainnet — from deployments/base-mainnet.json)
NEXT_PUBLIC_LAUNCH_FACTORY_ADDRESS=0x0C2744Aa1938ef8e7fA0A025C95126ffbacAf580
# Ethereum mainnet factory (live):
NEXT_PUBLIC_LAUNCH_FACTORY_ETHEREUM=0xd58e5EA7D8da706fA89e7EeE22Bd236Cf0F33B89
NEXT_PUBLIC_LAUNCH_DEFAULT_LP_ETH_MAINNET=0.05
NEXT_PUBLIC_FEE_COLLECTOR_ETHEREUM=0xb3c12C1656f0cA96DCEEdeAed0E3cD7348d62034
NEXT_PUBLIC_FEE_COLLECTOR_ADDRESS=0xcC61A3C647d416A124143Be1c367232BAA8fa51f
NEXT_PUBLIC_EYES_TOKEN_ADDRESS=0xC845770d0f437B93886E152566EE926Aa9153C9e
# Transparency (tokenomics page)
NEXT_PUBLIC_DEPLOYER_ADDRESS=0x2C8988415c9f2D2a8F9bAE2489e400e3a351d00f
# Gnosis Safe on Base (Ownable admin target after transfer-ownership-mainnet.ps1):
NEXT_PUBLIC_MULTISIG_ADDRESS=0xbe5B4c6aC168107C25510469fF02cc0896015bfa
NEXT_PUBLIC_OWNERSHIP_TRANSFERRED=true
# Audit — set when report is live:
# NEXT_PUBLIC_AUDIT_IN_PROGRESS=true
# NEXT_PUBLIC_AUDIT_REPORT_URL=https://...

# --- Mobile wallets (WalletConnect / Reown — optional) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Features (production) ---
NEXT_PUBLIC_FEATURE_WALLET=true
NEXT_PUBLIC_FEATURE_CREATE_LAUNCH=true
NEXT_PUBLIC_FEATURE_LAUNCH_SUPPORT=false
NEXT_PUBLIC_FEATURE_LIVE_STATS=false
NEXT_PUBLIC_FEATURE_RETENTION=true
NEXT_PUBLIC_FEATURE_DISCOVERY=true
NEXT_PUBLIC_FEATURE_UTILITY=true
NEXT_PUBLIC_FEATURE_ACCOUNT=true
LAUNCHES_SNAPSHOT_PATH=./data/launches-snapshot.json

# --- Launch LP defaults ---
NEXT_PUBLIC_LAUNCH_DEFAULT_LP_ETH=0.01
# Comma-separated enabled launch networks (factory/program must be wired per chain):
NEXT_PUBLIC_LAUNCH_CHAINS=base,ethereum,solana
# Solana fair launch program (after anchor deploy):
# NEXT_PUBLIC_SOLANA_LAUNCH_PROGRAM_ID=
# NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta   # use devnet for free testing
# NEXT_PUBLIC_LAUNCH_DEFAULT_LP_SOL=0.05   # min ~0.01 SOL LP (+ 0.19 SOL Raydium pool fee on mainnet)
# NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# RESEND_API_KEY=re_...
# EMAIL_FROM=Eyes Open <updates@eyesopen.to>

# --- Social (canonical links) ---
NEXT_PUBLIC_SOCIAL_X=https://x.com/eyesopenlaunch
NEXT_PUBLIC_SOCIAL_TELEGRAM=https://t.me/+WGZTDwqoswNlODMx
# NEXT_PUBLIC_SOCIAL_DISCORD=

# --- Team pool display (owner allocation) ---
# 10% of 1B = 100M owner allocation
NEXT_PUBLIC_TEAM_POOL_TOKENS=100000000

# --- Server-only security (REQUIRED on Vercel Production — build fails if missing) ---
PLATFORM_SNAPSHOT_PATH=./data/platform-snapshot.json
BOT_WEBHOOK_URL=https://eyesteam-production.up.railway.app
PLATFORM_API_SECRET=shared-secret-with-bot
TEAM_SESSION_SECRET=long-random-string-for-signed-cookies
# Recommended RPC providers:
# BASE_MAINNET_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# ETHEREUM_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# BASESCAN_API_KEY=your_etherscan_v2_key_with_base_coverage
