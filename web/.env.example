# Eyes Open web — environment variables (copy to .env.local)

# Launch countdown (optional)
# NEXT_PUBLIC_LAUNCH_END_ISO=2026-09-01T00:00:00.000Z

# Social links
# NEXT_PUBLIC_SOCIAL_X=https://x.com/yourhandle
# NEXT_PUBLIC_SOCIAL_TELEGRAM=https://t.me/yourgroup
# NEXT_PUBLIC_SOCIAL_DISCORD=

# Chain & contracts (Base Sepolia testnet)
# NEXT_PUBLIC_CHAIN_ID=84532
# NEXT_PUBLIC_CHAIN_NAME=Base Sepolia
# NEXT_PUBLIC_EYES_TOKEN_ADDRESS=
# NEXT_PUBLIC_LAUNCH_FACTORY_ADDRESS=
# NEXT_PUBLIC_FEE_COLLECTOR_ADDRESS=

# Presale (self-custodial ETH send)
# NEXT_PUBLIC_PRESALE_RECIPIENT=0xYourTreasuryOrMultisigAddress
# NEXT_PUBLIC_FEATURE_WALLET=true
# NEXT_PUBLIC_FEATURE_CREATE_LAUNCH=true
# NEXT_PUBLIC_FEATURE_LAUNCH_SUPPORT=true
# NEXT_PUBLIC_FEATURE_LIVE_STATS=true
